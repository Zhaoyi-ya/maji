<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 颜色引用 @color，深色模式由 values-night 自动切换；圆角自绘（原生 widget 无系统卡片包裹） -->
    <!-- 描边：即使填充接近桌面色也能勾出卡片轮廓（浅色桌面近白卡隐身问题的根治） -->
    <solid android:color="@color/widget_bg_color" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_card_stroke" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
